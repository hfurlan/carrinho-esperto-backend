# JVM options for the backend on the EC2 host (t3.micro, 1 GB RAM).
# Sourced by the backend's systemd unit on the EC2 host (infra/ec2/carrinho-esperto.service,
# created during EC2 provisioning). Tight heap for a single small instance; raise
# -Xmx or move to t3.small (~$15/mo, not Free Tier) if OOM occurs.
JAVA_OPTS=-Xmx512m -XX:MaxMetaspaceSize=256m -Xss512k
